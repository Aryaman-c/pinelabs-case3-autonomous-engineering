FROM python:3.12-slim

RUN apt-get update && apt-get install -y git coreutils && rm -rf /var/lib/apt/lists/*

RUN useradd -u 1000 -ms /bin/bash agent && \
    mkdir -p /workspace && \
    chown -R agent:agent /workspace

USER agent
WORKDIR /workspace

RUN git config --global user.name "Autonomous Agent" && \
    git config --global user.email "agent@pinelabs.com" && \
    git config --global init.defaultBranch main

COPY requirements.sandbox.txt /tmp/requirements.sandbox.txt
RUN pip install --no-cache-dir --user -r /tmp/requirements.sandbox.txt
ENV PATH="/home/agent/.local/bin:${PATH}"
